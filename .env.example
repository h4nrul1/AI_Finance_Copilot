# Copy this file to .env.local and fill in what you have. Every key is optional:
# without them the app still runs (offline copilot, guest-only mode).

# AI copilot and setup (platform.openai.com -> API keys)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Accounts (Supabase dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for "Delete my account". Never prefix it with NEXT_PUBLIC_ and never share it.
SUPABASE_SERVICE_ROLE_KEY=
